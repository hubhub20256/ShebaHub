{
  "info": {
    "name": "ShebaHub API Smoke",
    "description": "Smoke-test collection for the ShebaHub backend API. Covers auth, reference data, profiles, research, tasks, chat, and admin-panel read endpoints. Designed to be run end-to-end against a local dev server. Authenticated requests inherit a Bearer token captured from the Login request. Use the matching environment file `shebahub.local.postman_environment.json` and edit `user_email` / `user_password` to match a seeded test user before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"confirmPassword\": \"{{user_password}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"gender\": \"other\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 or 400 (already exists)', function () {",
                  "  pm.expect([201, 400, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test('response time < 2000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "pm.test('content-type is JSON', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/json/i);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.tokens) {",
                  "    pm.environment.set('access_token', json.tokens.access);",
                  "    pm.environment.set('refresh_token', json.tokens.refresh);",
                  "  }",
                  "  pm.test('returns user object with email', function () {",
                  "    pm.expect(json.user).to.have.property('email');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response time < 2000ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "pm.test('content-type is JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/json/i); });",
                  "const json = pm.response.json();",
                  "pm.test('returns access token', function () { pm.expect(json.tokens).to.have.property('access'); });",
                  "pm.test('returns refresh token', function () { pm.expect(json.tokens).to.have.property('refresh'); });",
                  "pm.environment.set('access_token', json.tokens.access);",
                  "pm.environment.set('refresh_token', json.tokens.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response time < 2000ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "pm.test('returns user with email', function () { pm.expect(pm.response.json()).to.have.property('email'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Token Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "token", "refresh", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 401 if missing token', function () { pm.expect([200, 401]).to.include(pm.response.code); });",
                  "pm.test('response time < 2000ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('returns new access token', function () { pm.expect(json).to.have.property('access'); });",
                  "  pm.environment.set('access_token', json.access);",
                  "  if (json.refresh) { pm.environment.set('refresh_token', json.refresh); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response time < 2000ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
                ]
              }
            }
          ]
        }
      ]
    },

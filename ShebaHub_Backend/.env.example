# Django Settings
ENVIRONMENT=development
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (SQLite by default)
# DB_ENGINE=
# For PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=shebahub_db
# DB_USER=shebahub_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Email Settings (console backend by default — emails printed to stdout)
# For AWS SES or other SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.eu-west-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-ses-smtp-user
# EMAIL_HOST_PASSWORD=your-ses-smtp-password
# DEFAULT_FROM_EMAIL=noreply@shebahub.hitheal.org.il

# Frontend URL (used in verification & reset links)
# FRONTEND_URL=http://localhost:5173

# Production only:
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Logging
# LOG_DIR=./logs
# DJANGO_LOG_LEVEL=INFO

# ClamAV antivirus scanning (optional)
# CLAMAV_ENABLED=False
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=
